# =====================================================================
#  Calendario Geoconsult — variabili d'ambiente
#  Copiare in .env.local (sviluppo) oppure impostare su Vercel.
# =====================================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- SMTP (riepilogo mensile + notifiche approvazione) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Destinatario del riepilogo mensile
MAIL_TO=

# =====================================================================
#  NOTIFICHE ASSENZE
# =====================================================================

# Canali attivi, separati da virgola: email | whatsapp
# Default "email". Per attivare WhatsApp: "email,whatsapp" oppure "whatsapp".
# Un canale elencato ma non configurato viene ignorato senza errori.
APPROVAL_CHANNELS=email

# URL pubblico dell'app: serve a costruire il link al calendario nelle notifiche.
# Su Vercel viene dedotto da VERCEL_URL se non impostata.
APP_BASE_URL=https://calendario.example.com

# Email del responsabile che riceve l'avviso. Se assente ricade su MAIL_TO.
APPROVER_EMAIL=

# ---------------------------------------------------------------------
#  WhatsApp Cloud API — opzionale, lasciare vuoto finche' non serve
# ---------------------------------------------------------------------
# Da Meta for Developers > la tua app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Numero del responsabile in formato internazionale SENZA + ne' spazi
# Esempio Italia: 393331234567
WHATSAPP_APPROVER_PHONE=

# Template approvato da Meta (vedi docs/notifiche-assenze.md)
WHATSAPP_TEMPLATE_NAME=richiesta_assenza
WHATSAPP_TEMPLATE_LANG=it
WHATSAPP_GRAPH_VERSION=v21.0
